@page "/"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<BoardState> Board
@inject IDispatcher Dispatcher
@implements IDisposable
<h1>Work Board</h1>
@if (Board.Value.AccessToken is null)
{
    <div>
        <label>Email <input data-testid="email" type="email" @bind="email" /></label>
        <label>Password <input data-testid="password" type="password" @bind="password" /></label>
        <button data-testid="login" @onclick="DoLogin" disabled="@Board.Value.Pending">Login</button>
    </div>
}
else
{
    <div>
        <label>Title <input data-testid="title" @bind="newTitle" /></label>
        <label>Status <select data-testid="create-status" @bind="newStatus"><option>Todo</option><option>InProgress</option><option>Done</option></select></label>
        <button data-testid="add" @onclick="DoAdd" disabled="@Board.Value.Pending">Add</button>
        <label>Filter <select data-testid="filter" @bind="filter"><option>All</option><option>Todo</option><option>InProgress</option><option>Done</option></select></label>
        <button data-testid="logout" @onclick="DoLogout">Logout</button>
        <div data-testid="items">
            @foreach (var item in VisibleItems)
            {
                <div data-testid="item-row">
                    <span>@item.Title</span>
                    <span>@item.Status</span>
                    <span>@item.Version</span>
                    <input data-testid="edit-title" @bind="item.Title" />
                    <select data-testid="edit-status" @bind="item.Status"><option>Todo</option><option>InProgress</option><option>Done</option></select>
                    <button data-testid="save" @onclick="() => DoSave(item)" disabled="@Board.Value.Pending">Save</button>
                    <button data-testid="delete" @onclick="() => DoDelete(item)" disabled="@Board.Value.Pending">Delete</button>
                </div>
            }
        </div>
    </div>
}
@if (Board.Value.Error is not null)
{
    <div role="alert">@Board.Value.Error</div>
}
@code {
    private string email = "";
    private string password = "";
    private string newTitle = "";
    private string newStatus = "Todo";
    private string filter = "All";
    private IDisposable? subscription;
    protected override void OnInitialized()
    {
        subscription = Board.Subscribe(state =>
        {
            filter = state.Filter;
            StateHasChanged();
        });
    }
    private IEnumerable<WorkItemView> VisibleItems => Board.Value.Items.Where(i => filter == "All" || i.Status == filter);
    private void DoLogin() => Dispatcher.Dispatch(new LoginRequested(Guid.NewGuid(), email, password));
    private void DoAdd() => Dispatcher.Dispatch(new AddRequested(Guid.NewGuid(), newTitle, newStatus));
    private void DoSave(WorkItemView item) => Dispatcher.Dispatch(new UpdateRequested(Guid.NewGuid(), item.Id, item.Title, item.Status, item.Version));
    private void DoDelete(WorkItemView item) => Dispatcher.Dispatch(new DeleteRequested(Guid.NewGuid(), item.Id, item.Version));
    private void DoLogout() => Dispatcher.Dispatch(new LogoutRequested());
    public void Dispose() => subscription?.Dispose();
}
