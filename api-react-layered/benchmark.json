{
  "schemaVersion": 1,
  "name": "api-react-layered",
  "description": "Layered .NET API with JWT, atomic versioned private work items, and React Redux Toolkit workflow",
  "promptFile": "PROMPT.md",
  "instructionFiles": ["AGENTS.md", "FEATURES.md", "ARCHITECTURE.md"],
  "prepareCommands": [
    ["dotnet", "restore", "Benchmark.slnx", "--locked-mode"],
    ["npm", "--prefix=frontend", "ci"]
  ],
  "validationCommands": [
    ["dotnet", "test", "Benchmark.slnx", "--no-restore", "--logger", "trx;LogFileName=acceptance.trx", "--results-directory", "TestResults"],
    ["npm", "--prefix=frontend", "run", "build"],
    ["npm", "--prefix=frontend", "test"]
  ],
  "protectedPaths": [
    "tests", "benchmark.json", "PROMPT.md", "FEATURES.md", "ARCHITECTURE.md", "AGENTS.md", "README.md",
    "global.json", "Directory.Build.props", "Benchmark.slnx", ".gitignore", "frontend/tests",
    "frontend/package.json", "frontend/package-lock.json", "frontend/tsconfig.json", "frontend/vite.config.ts", "frontend/index.html",
    "src/WorkBoard.Domain/WorkBoard.Domain.csproj", "src/WorkBoard.Domain/packages.lock.json",
    "src/WorkBoard.Application/WorkBoard.Application.csproj", "src/WorkBoard.Application/packages.lock.json",
    "src/WorkBoard.Infrastructure/WorkBoard.Infrastructure.csproj", "src/WorkBoard.Infrastructure/packages.lock.json",
    "src/WorkBoard.Api/WorkBoard.Api.csproj", "src/WorkBoard.Api/packages.lock.json"
  ],
  "editablePaths": ["src", "frontend/src"],
  "expectedTests": 73,
  "timeoutSeconds": 3600
}
